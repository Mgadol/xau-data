// ─────────────────────────────────────────────────────────────────────
//  ШАХАЛТ — XAUUSD
//
//  2004–2026 оны 1.44 сая 5 минутын бар дээрх шинжилгээнээс ЗӨВХӨН
//  шахалтын механизмыг үлдээв. Бусад арга барил нь шалгалтад юу ч
//  нэмээгүй тул хасагдсан — доороос үзнэ үү.
//
//  ── ДҮРЭМ ────────────────────────────────────────────────────────
//   1. Шахалт: ATR14 ÷ ATR100 ≤ 0.80
//   2. Хил: 20 барын дундаж ± 1.5 ATR (өргөн нь яг 3 ATR)
//   3. Зөвхөн ДЭЭШ задрал дээр арилжаа
//   4. Хил дээр ор — баталгаа бүү хүлээ. Нээлт хилээс хэтэрсэн бол
//      нээлтийн үнээр (тэр үнээр л авч чадна)
//   5. Стоп 2 ATR, зорилт 1 ATR → 4 ATR
//   6. 5 барт задрал ирэхгүй бол болих
//   7. Доош задрал болсны дараа дээш задралыг АВАХГҮЙ (доор үзнэ үү)
//
//  ── ЗӨВХӨН ӨДРИЙН ГРАФИК ─────────────────────────────────────────
//   Энэ кодын логикоор давхрага бүрийг жинхэнэ оролтын үнээр
//   хэмжихэд (спред $0.25, зорилт 4 ATR):
//
//     давхрага     n       R        t     ялсан   жилд   эерэг жил
//     15 мин    8259   −0.164  −12.24     36%    514      1/17
//     30 мин    4078   −0.130   −6.59     36%    254      3/17
//      1 цаг    2119   −0.125   −4.58     35%    132      4/17
//      2 цаг     672   +0.069   +1.39     43%     42     12/17
//      3 цаг     532   −0.016   −0.28     39%     33      8/17
//      4 цаг     324   +0.002   +0.02     39%     20      7/16
//      6 цаг     231   −0.006   −0.07     39%     15      8/16
//      8 цаг     140   +0.138   +1.29     44%      9     13/16
//      ӨДӨР       66   +0.547   +3.48     61%      3     12/20
//
//   15 МИНУТ НЬ ХАМГИЙН МУУ — t = −12.24, 17 жилийн ганцхан жилд
//   эерэг. Спред тэглэсэн ч сөрөг ($0.10 дээр −0.095R). Жилд 514
//   дохио × −0.164R = жилд −84R.
//
//   ГЭСЭН Ч ГРАФИКТ САЙН ХАРАГДДАГ. Гурван шалтгаан: (1) ялагчид
//   нүдэнд тусдаг, шууд стоп цохисон нь алга болдог; (2) ялахдаа
//   4 ATR, алдахдаа 2 ATR явдаг тул ялалт нь илүү үнэмшилтэй
//   харагдана; (3) 500 дохионоос гайхалтай жишээ заавал олдоно.
//   Графикаар ийм зүйлийг шийдэж БОЛОХГҮЙ.
//
//   Өдрийн график ганцаараа үлдэв:
//
//     n = 66 (2005–2026)    +0.547R    t = 3.48
//     95% итгэлийн завсар   +0.239 … +0.854R
//     bootstrap 20000       тэгээс дээш байх магадлал 100%
//     2005–2015 +0.471R     2016–2026 +0.622R
//     сайн 5 арилжааг хассан ч +0.428R
//     спред $1.00-д ч +0.521R
//
//  ── ДООШ ЗАДРАЛЫН ДАРААХ ХОРИГ ───────────────────────────────────
//   Доош задрал болсны дараа удалгүй дээш задрал гарвал АВАХГҮЙ.
//   Тэр нь зурвасыг ХОЁР ТИЙШ нь эвдсэн зах — хил утгаа алдсан
//   байна. Хэмжсэн (өдрийн график):
//
//     хориггүй   n=66  +0.547R  ялсан 61%  нийт +36.1R
//     хоригтой   n=63  +0.622R  ялсан 63%  нийт +39.2R
//
//     2005–2015  +0.471 → +0.521     2016–2026  +0.622 → +0.725
//
//   Хоёр үед ХОЁУЛАНД нь эерэг. Хаагдсан 7 дохионы дундаж −0.315R;
//   санамсаргүйгээр ийм муу 7-г сонгох магадлал 3.1%.
//
//   Болгоомжлол: 7 дохио гэдэг цөөн бөгөөд +0.075R нь n=66 дээрх
//   стандарт алдаа (±0.16R) дотор багтана. Механизм үнэмшилтэй,
//   хоёр үед эерэг — гэхдээ «батлагдсан» гэж хэлэхэд эрт.
//
//  ── ЮУГ ХАССАН, ЯАГААД ───────────────────────────────────────────
//   Бүгдийг ЭНЭ кодын логик дээр тусад нь хэмжив (өдрийн график):
//
//     зөвхөн шахалт           n=66  +0.547R  t=3.48   ← ЭНЭ
//     + хөлийн чиглэл         n=60  +0.556R  t=3.36
//     + байрлалын шүүлтүүр    n=64  +0.517R  t=3.20
//     + хоёул                 n=60  +0.551R  t=3.30
//
//   Аль нь ч R-ийг нэмээгүй, арилжааг цөөрүүлж t-г БУУРУУЛСАН.
//   Тиймээс хасав: байрлалын шүүлтүүр, хөл/зигзаг, идэвхийн чиглэл,
//   сессийн шүүлтүүр.
//
//   Мөн урьд нь шалгалт даваагүй тул огт ороогүй: Фибоначчи (зурвас
//   нь 3 ATR тул «фибо f» = «3f ATR», тэг мэдээлэл), макро өгөгдөл
//   (VIX, DXY, өгөөжийн муруй, зээлийн спред, S&P, тос, биткойн),
//   машин сургалт, Dow, Elliott, олон давхрага нийцүүлэх (бүрэн
//   эгнээ нь ХАМГИЙН МУУ), баталгааны буфер (R-ийг бууруулна),
//   дугуй тоо, pivot, өчигдрийн дээд/доод.
//
//  ── ХЯЗГААР ──────────────────────────────────────────────────────
//   · Жилд ердөө ~3 тохиргоо. Тэвчээр шаардана.
//   · Ирмэг нь алтны урт хугацааны ӨСӨЛТӨӨС ирдэг. 2012–2015
//     буурлын үед ашиг ~0 болсон.
//   · Задралын 12% нь 0.5 ATR ч явахгүй унтардаг. Үргэлжлэлийн
//     тархалт: 5%-д 0.21 ATR, медиан 1.75, 95%-д 7.97.
//   · Хамгийн урт алдагдлын цуваа 5 дохио, хамгийн гүн унал −5.4R.
//     Байршлын хэмжээг −6R-ийг тэсэхээр тавь.
//   · БОГИНО ТАЛ: доош задрал дангаараа бүх тестэд алдагдалтай
//     (−0.11…−0.15R). Код нь ЗУРНА, гэхдээ дохио өгөхгүй — түүний
//     цорын ганц үүрэг нь дээш задралыг хориглох.
//
//  Шалгах: python3 shinjilgee/e1_pine.py
// ─────────────────────────────────────────────────────────────────────

//@version=6
indicator("Шахалт — XAUUSD", "ШАХАЛТ", overlay = true,
     max_labels_count = 500)

// ── Оролтууд ─────────────────────────────────────────────────────────
gS = "Шахалт"
atrFast = input.int(14, "Хурдан ATR", minval = 2, group = gS,
     tooltip = "Маргаашийн өдрийн мужийн 90% нь энэ ATR-ийн 1.63 " +
     "дахинд багтдаг — 2020-2025 зургаан жилд 1.58…1.70.")
atrSlow = input.int(100, "Удаан ATR", minval = 20, group = gS)
sqThr = input.float(0.80, "Шахалтын босго", minval = 0.1, step = 0.01,
     group = gS, tooltip = "ATR14/ATR100 ≤ энэ утга бол шахагдсан. " +
     "Шахагдсан бүлэг 5 хоногт 3.64 ATR явсан, тэлсэн нь 2.30. " +
     "21 жилийн 21-д нь ижил чиглэлд.")

gB = "Хил"
maLen = input.int(20, "Дундажийн урт", minval = 2, group = gB)
bandMult = input.float(1.5, "ATR үржигдэхүүн", minval = 0.1, step = 0.1,
     group = gB, tooltip = "Дундаж ± 1.5 ATR. Зурвасын өргөн ингэснээр " +
     "ЯГ 3 ATR болно.")

gT = "Арилжаа"
stopAtr = input.float(2.0, "Стоп (ATR)", minval = 0.1, step = 0.1,
     group = gT, tooltip = "Задарсны дараах таталтын 65–70% нь 2 ATR " +
     "дотор багтана (медиан 1.40, 70% 2.13, 80% 2.60, 90% 3.68).")
t1Atr = input.float(1.0, "Зорилт 1 (ATR)", minval = 0.1, step = 0.1,
     group = gT, tooltip = "74% хүрдэг. 2 ATR — 45%, 3 ATR — 26%.")
t2Atr = input.float(4.0, "Зорилт 2 (ATR)", minval = 0.1, step = 0.1,
     group = gT, tooltip = "3.8–4.0 ATR дээр R тэгширнэ: 3.0 → +0.398R, " +
     "3.8 → +0.517R, 4.0 → +0.551R, 6.0 → +0.396R.")
maxBars = input.int(5, "Задрал хүлээх бар", minval = 1, group = gT,
     tooltip = "Задрал ихэвчлэн 2.7–3.2 барт ирдэг.")
holdBars = input.int(15, "Барих дээд бар", minval = 1, group = gT)

gD = "Доош задрал"
blockUp = input.bool(true, "Доош задралын дараа дээшийг хориглох",
     group = gD, tooltip = "Зурвасыг хоёр тийш нь эвдсэн зах — хил " +
     "утгаа алдсан байна. Хэмжсэн: +0.547R → +0.622R (n 66→63), " +
     "хоёр үед хоёуланд нь эерэг. ГЭХДЭЭ 7 дохионы ялгаа тул " +
     "баталгаатай гэж үзэж болохгүй.")
blockBars = input.int(15, "Хоригийн дээд бар", minval = 1, group = gD,
     tooltip = "Хориг нь доош задрал стоп/зорилтод хүрэхэд эсвэл энэ " +
     "хугацаа өнгөрөхөд тайлагдана. 15-аар хэмжсэн — өөрчлөх бол " +
     "эхлээд e1_pine.py дээр хэмж.")

gV = "Харагдац"
colBars = input.bool(true, "Лааг будах", group = gV,
     tooltip = "Шахагдсан лаа шар, дээш задрал ногоон, доош улаан.")
showLbl = input.bool(true, "Лаан дээр шошго", group = gV,
     tooltip = "Шахалт эхлэх ба задралын лаан дээр тоог нь шууд бичнэ. " +
     "Арилжаа явж байхад оролт/стоп/зорилтын шошго баруун талд гарна.")
showBands = input.bool(true, "Зурвас харуулах", group = gV)
showLvls = input.bool(true, "Түвшин харуулах", group = gV)
showPanel = input.bool(true, "Самбар харуулах", group = gV)
showShort = input.bool(true, "Доош задрал зурах", group = gV,
     tooltip = "ЗӨВХӨН харагдац. Богино тал дангаараа бүх тестэд " +
     "алдагдалтай тул дохио өгдөггүй.")
panelPos = input.string("Баруун дээд", "Самбарын байрлал", group = gV,
     options = ["Баруун дээд", "Баруун доод", "Зүүн дээд", "Зүүн доод"])
txtSize = input.string("Жижиг", "Бичгийн хэмжээ", group = gV,
     options = ["Маш жижиг", "Жижиг", "Дунд"])

// ── Өнгө ─────────────────────────────────────────────────────────────
cGood = #26a69a
cWarn = #f4a13a
cBad  = #ef5350
cDim  = #787b86
cInk  = #d1d4dc
cBg   = color.new(#1b1f2a, 15)
cHead = color.new(#2a3142, 0)

// Үнийг хэрэгслийн нарийвчлалаар бичнэ. Шошго ба самбар хоёулаа энийг
// хэрэглэнэ — тиймээс өнгөний дараа шууд тодорхойлов.
f2(float x) => na(x) ? "—" : str.tostring(x, format.mintick)

// ── Суурь тооцоо ─────────────────────────────────────────────────────
// ta.atr() нь Уайлдерын жигдрүүлэлт (RMA) — судалгаа нь ЭНГИЙН дундаж
// ашигласан. Хоёр нь өөр тоо өгдөг тул энд судалгааных нь давтагдана.
tr   = ta.tr(true)
atrF = ta.sma(tr, atrFast)
atrS = ta.sma(tr, atrSlow)
sq   = atrS > 0 ? atrF / atrS : na

basis = ta.sma(close, maLen)
upB   = basis + bandMult * atrF
dnB   = basis - bandMult * atrF
wid   = upB - dnB

sqOn    = not na(sq) and sq <= sqThr
sqStart = sqOn and not sqOn[1]
// ta.barssince нь төлөвтэй тул ЗААВАЛ болзолгүй дуудагдана.
bsSq  = ta.barssince(not sqOn)
sqLen = sqOn ? nz(bsSq) : 0

// ── Төлөв ────────────────────────────────────────────────────────────
// Эдгээр нь `var` тул барын ЭХЭНД өмнөх барын утгыг барина. Дохиог
// эхэлж бодож, анкрыг ХАМГИЙН СҮҮЛД шинэчилнэ — ингэснээр тухайн бар
// өөрийн хилээр өөрийгөө баталгаажуулахгүй.
var float aUp    = na
var float aDn    = na
var float aAtr   = na
var int   aBar   = na
var bool  aLive  = false
var bool  aFired = false

// Дээш арилжаа
var float tEntry = na
var float tStop  = na
var float tT1    = na
var float tT2    = na
var int   tBar   = na
var bool  tOpen  = false
var bool  tHit1  = false

// Доош задрал — ЗУРАГЛАЛ ба ХОРИГ. Арилжааны дохио БИШ.
var float dEntry = na
var float dStop  = na
var float dT2    = na
var int   dBar   = na
var bool  dOpen  = false

// ── Дохио ────────────────────────────────────────────────────────────
waited = na(aBar) ? 0 : bar_index - aBar
fresh  = aLive and not aFired and waited >= 1 and waited <= maxBars

// Нээлт хилээс хэтэрсэн бол ХИЛ ДЭЭР ОРОХ БОЛОМЖГҮЙ — жинхэнэ оролт нь
// нээлтийн үнэ. Алгасах нь ХЭТ ХАТУУ (тохиргооны гуравны нэгийг хаяж,
// R-ийг бууруулдаг). Орох нь зөв, гэхдээ жинхэнэ үнээр — стоп ба
// зорилтыг тэрнээс нь хэмжинэ.
gapUp = not na(aUp) and open >= aUp
gapDn = not na(aDn) and open <= aDn
brkUp = fresh and not na(aUp) and high >= aUp
brkDn = fresh and not na(aDn) and low <= aDn
entryPx   = gapUp ? open : aUp
dnEntryPx = gapDn ? open : aDn

// Доош задралын хориг. Нэг барт хоёр тал зэрэг эвдэгдвэл дээш давуу.
blocked = blockUp and dOpen
longSig = brkUp and not tOpen and not blocked
downSig = brkDn and not brkUp and not tOpen and not dOpen

// Нэг зэвсэглэлд нэг л задрал. Шахалт үргэлжилж байвал доор дахин
// зэвсэглэнэ.
if brkUp or brkDn
    aFired := true

// ── Дээш арилжаа ─────────────────────────────────────────────────────
if longSig
    tEntry := entryPx
    tStop  := entryPx - stopAtr * aAtr
    tT1    := entryPx + t1Atr * aAtr
    tT2    := entryPx + t2Atr * aAtr
    tBar   := bar_index
    tOpen  := true
    tHit1  := false

// ── Доош задрал — зураглал ба хориг ──────────────────────────────────
if downSig
    dEntry := dnEntryPx
    dStop  := dnEntryPx + stopAtr * aAtr
    dT2    := dnEntryPx - t2Atr * aAtr
    dBar   := bar_index
    dOpen  := true

// Стоп ТҮРҮҮЛЖ шалгагдана — барын дотор аль нь эхэлснийг мэдэх аргагүй
// тул муу талыг нь сонгоно.
if tOpen
    if low <= tStop
        tOpen := false
    else
        if high >= tT1
            tHit1 := true
        if high >= tT2
            tOpen := false
        else if bar_index - tBar >= holdBars
            tOpen := false

// Доош тал нь ижил дүрмээр «дуусна» — хориг тэр үед тайлагдана.
if dOpen
    if high >= dStop
        dOpen := false
    else if low <= dT2
        dOpen := false
    else if bar_index - dBar >= blockBars
        dOpen := false

// ── Анкр ─────────────────────────────────────────────────────────────
if sqOn
    aUp    := upB
    aDn    := dnB
    aAtr   := atrF
    aBar   := bar_index
    aLive  := true
    aFired := false
else if aLive and waited > maxBars
    aLive := false

// ── Зураглал ─────────────────────────────────────────────────────────
pU = plot(showBands ? upB : na, "Дээд хил", color.new(cDim, 30), 1)
pD = plot(showBands ? dnB : na, "Доод хил", color.new(cDim, 30), 1)
plot(showBands ? basis : na, "Дундаж", color.new(cDim, 60), 1)
fill(pU, pD, sqOn ? color.new(cWarn, 92) : color.new(cDim, 97), "Зурвас")

aShow = aLive and not aFired
plot(showLvls and aShow ? aUp : na, "Анкр дээд", color.new(cGood, 0), 2,
     plot.style_linebr)
plot(showLvls and aShow ? aDn : na, "Анкр доод", color.new(cBad, 55), 1,
     plot.style_linebr)

plot(showLvls and tOpen ? tEntry : na, "Оролт", color.new(cInk, 0), 1,
     plot.style_linebr)
plot(showLvls and tOpen ? tStop : na, "Стоп", color.new(cBad, 0), 1,
     plot.style_linebr)
plot(showLvls and tOpen ? tT1 : na, "Зорилт 1", color.new(cGood, 45), 1,
     plot.style_linebr)
plot(showLvls and tOpen ? tT2 : na, "Зорилт 2", color.new(cGood, 0), 1,
     plot.style_linebr)

// Доош талын түвшин нь СУДАЛГААНЫ харагдац — бүдэг, дохио биш.
plot(showLvls and showShort and dOpen ? dEntry : na, "Доош эвдрэл",
     color.new(cDim, 25), 1, plot.style_linebr)
plot(showLvls and showShort and dOpen ? dStop : na, "Доош буцалт",
     color.new(cBad, 55), 1, plot.style_linebr)

bgcolor(sqOn ? color.new(cWarn, 94) : na, title = "Шахалтын дэвсгэр")

plotshape(sqStart, "Шахалт эхэллээ", shape.diamond, location.belowbar,
     color.new(cWarn, 0), size = size.tiny)
plotshape(longSig, "ДЭЭШ задрал — оролт", shape.triangleup,
     location.belowbar, color.new(cGood, 0), size = size.small)
plotshape(showShort and downSig, "ДООШ задрал (дохио БИШ)",
     shape.triangledown, location.abovebar, color.new(cBad, 25),
     size = size.small)
// Хоригт таслагдсан дээш задрал — юу болсныг харуулна.
plotshape(brkUp and blocked and not tOpen, "Дээш задрал — ХОРИГДСОН",
     shape.xcross, location.belowbar, color.new(cDim, 20), size = size.tiny)

// ── Лаан дээрх өнгө ба шошго ─────────────────────────────────────────
// Булан дахь самбар руу харахгүйгээр лаанаасаа шууд уншихын тулд.
barcolor(not colBars ? na :
     longSig ? cGood :
     (showShort and downSig) ? cBad :
     sqOn ? color.new(cWarn, 35) : na, title = "Лааны өнгө")

// Шахалт эхэлсэн лаан дээр утгыг нь шууд бичнэ.
if showLbl and sqStart
    label.new(bar_index, low, "ШАХАЛТ " + str.tostring(sq, "#.00"),
         style = label.style_label_up, color = color.new(cWarn, 15),
         textcolor = #14181f, size = size.tiny,
         tooltip = "Доод хил: " + f2(dnB) + "\nДээд хил: " + f2(upB) +
         "\nЗадрал " + str.tostring(maxBars) + " барт ирэхгүй бол болих.")

// Задралын лаан дээр БҮХ тоог нэг дор.
if showLbl and longSig
    label.new(bar_index, high,
         "ОРОЛТ " + f2(tEntry) + "\nстоп " + f2(tStop) +
         "\nз1 " + f2(tT1) + "\nз2 " + f2(tT2),
         style = label.style_label_down, color = color.new(cGood, 10),
         textcolor = #0d1117, size = size.small,
         tooltip = "Эрсдэл " + str.tostring(stopAtr, "#.#") + " ATR = " +
         f2(tEntry - tStop) + "\nз1 нь 74% хүрдэг.")

if showLbl and showShort and downSig
    label.new(bar_index, low, "ДООШ " + f2(dEntry),
         style = label.style_label_up, color = color.new(cBad, 25),
         textcolor = #ffffff, size = size.tiny,
         tooltip = "ДОХИО БИШ — богино тал бүх тестэд алдагдалтай " +
         "(−0.11…−0.15R).\nҮүрэг нь дээш задралыг " +
         str.tostring(blockBars) + " бар хүртэл хориглох.")

// Арилжаа явж байхад түвшний шошго СҮҮЛИЙН лаан дээр гарч, зөвхөн
// нэг хувь үлдэнэ (өмнөхийг нь устгана).
var label lbE = na
var label lbS = na
var label lb1 = na
var label lb2 = na
var label lbA = na
if showLbl and barstate.islast
    label.delete(lbE)
    label.delete(lbS)
    label.delete(lb1)
    label.delete(lb2)
    label.delete(lbA)
    if tOpen
        lbE := label.new(bar_index, tEntry, "оролт " + f2(tEntry),
             style = label.style_label_left, color = color.new(cInk, 20),
             textcolor = #0d1117, size = size.tiny)
        lbS := label.new(bar_index, tStop, "стоп " + f2(tStop),
             style = label.style_label_left, color = color.new(cBad, 15),
             textcolor = #0d1117, size = size.tiny)
        lb1 := label.new(bar_index, tT1, "з1 " + f2(tT1),
             style = label.style_label_left, color = color.new(cGood, 45),
             textcolor = #0d1117, size = size.tiny)
        lb2 := label.new(bar_index, tT2, "з2 " + f2(tT2),
             style = label.style_label_left, color = color.new(cGood, 15),
             textcolor = #0d1117, size = size.tiny)
    else if blocked
        lbA := label.new(bar_index, nz(aUp, close), "ХОРИГДСОН · " +
             str.tostring(blockBars - (bar_index - dBar)) + " бар",
             style = label.style_label_left, color = color.new(cDim, 20),
             textcolor = #0d1117, size = size.tiny)
    else if aShow
        lbA := label.new(bar_index, aUp, "ор " + f2(aUp) + "  ·  " +
             str.tostring(maxBars - waited) + " бар",
             style = label.style_label_left, color = color.new(cGood, 25),
             textcolor = #0d1117, size = size.tiny)

// ── Самбар ───────────────────────────────────────────────────────────
tfm = timeframe.in_seconds() / 60.0
isDay = tfm >= 1440
tfTxt = isDay ? "+0.55R · 61% ялсан · жилд 3" :
         tfm >= 60 ? "ТЭГ эсвэл СӨРӨГ — өдрийн график ашигла" :
         "−0.16R · t=−12 · 17 жилийн 1-д л эерэг · БҮҮ АРИЛЖАА"
tfCol = isDay ? cGood : cBad

sqCol = sqOn ? cGood : not na(sq) and sq >= 1.2 ? cBad : cWarn
sqTxt = sqOn ? "ШАХАГДСАН · " + str.tostring(sqLen) + " бар" :
         not na(sq) and sq >= 1.2 ? "тэлсэн" : "дунд"

verdict = ""
vdCol = cDim
if tOpen
    verdict := "АРИЛЖАА ЯВЖ БАЙНА" + (tHit1 ? " · зорилт 1 хүрсэн" : "")
    vdCol := cGood
else if blocked
    verdict := "ХОРИГДСОН — доош задралаас хойш " +
         str.tostring(bar_index - dBar) + " бар. Дээшийг авахгүй."
    vdCol := cBad
else if sqOn
    verdict := "БЭЛЭН — дээд хил дээр ор, баталгаа бүү хүлээ"
    vdCol := cGood
else if aShow and waited >= 1 and waited <= maxBars
    verdict := "ЗАДРАЛ ХҮЛЭЭЖ БАЙНА — " + str.tostring(maxBars - waited) +
         " бар үлдэв"
    vdCol := cWarn
else
    verdict := "Тохиргоо идэвхгүй — шахалт алга (sq > " +
         str.tostring(sqThr, "#.00") + ")"
    vdCol := cDim

pPos = panelPos == "Баруун дээд" ? position.top_right :
       panelPos == "Баруун доод" ? position.bottom_right :
       panelPos == "Зүүн дээд" ? position.top_left : position.bottom_left
pSz = txtSize == "Маш жижиг" ? size.tiny :
      txtSize == "Жижиг" ? size.small : size.normal

var table pnl = table.new(pPos, 3, 10, border_width = 1,
     border_color = color.new(#2a3142, 40), frame_width = 1,
     frame_color = color.new(#2a3142, 20))

row(int r, string a, string b, string c, color col) =>
    table.cell(pnl, 0, r, a, text_color = cInk, text_size = pSz,
         bgcolor = cBg, text_halign = text.align_left)
    table.cell(pnl, 1, r, b, text_color = col, text_size = pSz,
         bgcolor = cBg, text_halign = text.align_right)
    table.cell(pnl, 2, r, c, text_color = color.new(col, 30),
         text_size = pSz, bgcolor = cBg, text_halign = text.align_left)

span(int r, string s, color fg, color bg) =>
    table.cell(pnl, 0, r, s, text_color = fg, text_size = pSz,
         bgcolor = bg, text_halign = text.align_left)
    table.cell(pnl, 1, r, "", bgcolor = bg)
    table.cell(pnl, 2, r, "", bgcolor = bg)
    table.merge_cells(pnl, 0, r, 2, r)

lvlBase = tOpen ? tEntry : aShow ? aUp : upB
lvlAtrR = tOpen or aShow ? aAtr : atrF
lvlAtr  = na(lvlAtrR) ? atrF : lvlAtrR

if showPanel and barstate.islast
    // Нэгтгэсэн нүдийг дахин бичиж болдоггүй тул эхлээд цэвэрлэнэ.
    table.clear(pnl, 0, 0, 2, 9)
    span(0, "ШАХАЛТ · " + syminfo.ticker + " · " + timeframe.period,
         cInk, cHead)
    row(1, "Шахалт " + str.tostring(atrFast) + "/" + str.tostring(atrSlow),
         na(sq) ? "—" : str.tostring(sq, "#.00"), sqTxt, sqCol)
    row(2, "Хил", f2(dnB) + " … " + f2(upB),
         (atrF > 0 ? str.tostring(wid / atrF, "#.00") : "—") + " ATR", cDim)
    row(3, "Давхрага", timeframe.period, tfTxt, tfCol)
    row(4, "Оролт · дээд хил", f2(lvlBase),
         blocked ? "ХОРИГДСОН — доош задрал болсон" :
         gapUp and aShow ? "нээлт ХЭТЭРСЭН — нээлтийн үнээр" :
         "баталгаа хүлээхгүй",
         blocked ? cBad : gapUp and aShow ? cWarn : cInk)
    row(5, "Стоп · " + str.tostring(stopAtr, "#.#") + " ATR",
         f2(lvlBase - stopAtr * lvlAtr), "= 1R", cBad)
    row(6, "Зорилт 1 · " + str.tostring(t1Atr, "#.#") + " ATR",
         f2(lvlBase + t1Atr * lvlAtr),
         "74% хүрдэг · " + str.tostring(t1Atr / stopAtr, "#.0") + "R", cGood)
    row(7, "Зорилт 2 · " + str.tostring(t2Atr, "#.#") + " ATR",
         f2(lvlBase + t2Atr * lvlAtr),
         str.tostring(t2Atr / stopAtr, "#.0") + "R", cGood)
    span(8, verdict, vdCol, cBg)
    span(9, "Зөвхөн ДЭЭШ · зөвхөн ӨДРИЙН график · задралын 12% нь " +
         "0.5 ATR ч явахгүй", color.new(cDim, 10), cBg)

// ── Сэрэмжлүүлэг ─────────────────────────────────────────────────────
// Доош задралд сэрэмжлүүлэг ЗОРИУД байхгүй — тэр нь дохио биш.
alertcondition(sqStart, "Шахалт эхэллээ",
     "Шахалт эхэллээ — тохиргоо идэвхжив")
alertcondition(longSig, "ДЭЭШ задрал — оролт", "ДЭЭШ задрал")

if sqStart
    alert("ШАХАЛТ ЭХЭЛЛЭЭ · " + syminfo.ticker + " " + timeframe.period +
         "\nsq = " + str.tostring(sq, "#.00") +
         "\nХил: " + f2(dnB) + " … " + f2(upB) +
         "\nЗадрал " + str.tostring(maxBars) + " барт ирэхгүй бол болих.",
         alert.freq_once_per_bar_close)

if longSig
    alert("ДЭЭШ ЗАДРАЛ · " + syminfo.ticker + " " + timeframe.period +
         "\nОролт " + f2(tEntry) + "   Стоп " + f2(tStop) +
         "\nЗорилт1 " + f2(tT1) + "   Зорилт2 " + f2(tT2) +
         "\nATR " + f2(aAtr) + "   1R = " + f2(tEntry - tStop),
         alert.freq_once_per_bar_close)
